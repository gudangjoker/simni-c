rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ==========================================
    // USERNAMES (PRE-CHECK & RESERVATION)
    // ==========================================

    match /usernames/{usernameLower} {
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30
        && usernameLower == request.resource.data.username.lower()
        && !exists(/databases/$(database)/documents/usernames/$(usernameLower));
      allow update: if false; // Username is immutable
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ==========================================
    // PRIVATE ACCOUNT DOCUMENT (OWNER ONLY)
    // Zero Email Exposure: Only the owner can read
    // ==========================================

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'username', 'usernameLower', 'displayName',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 60;
      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'username', 'usernameLower', 'displayName',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.email == resource.data.email
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.uid == uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // ==========================================
    // PUBLIC PROFILE DOCUMENT (PUBLIC-SAFE)
    // Readable by any authenticated user for search/chat
    // Strictly NO email, credentials, or private material
    // ==========================================

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameLower', 'displayName',
          'avatarUrl', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 30
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 60
        && !('email' in request.resource.data);
      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameLower', 'displayName',
          'avatarUrl', 'bio', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.createdAt == resource.data.createdAt
        && !('email' in request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    // ==========================================
    // CHAT CORE & CRYPTO RULES
    // ==========================================

    function validPublicKey(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'version', 'publicJwk', 'fingerprint', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.version == 1
        && request.resource.data.fingerprint is string
        && request.resource.data.fingerprint.size() <= 128
        && request.resource.data.publicJwk is map;
    }

    function validKeyBackup(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'version', 'fingerprint', 'backup', 'updatedAt', 'autoRecovery'])
        && request.resource.data.uid == uid
        && request.resource.data.version == 1
        && request.resource.data.fingerprint is string
        && request.resource.data.backup is map
        && request.resource.data.autoRecovery == null;
    }

    function validMilestone2PlaintextMessage() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'transportMode', 'type', 'senderUid', 'recipientUid',
          'plaintext', 'replyTo', 'createdAt'
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.transportMode == 'm2-plaintext'
        && request.resource.data.type == 'text'
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && request.resource.data.plaintext is string
        && request.resource.data.plaintext.size() > 0
        && request.resource.data.plaintext.size() <= 65536
        && (
          !('replyTo' in request.resource.data)
          || request.resource.data.replyTo == null
          || (
            request.resource.data.replyTo is map
            && request.resource.data.replyTo.keys().hasOnly(['messageId', 'senderUid', 'type'])
            && request.resource.data.replyTo.messageId is string
            && request.resource.data.replyTo.messageId.size() <= 128
            && request.resource.data.replyTo.senderUid is string
            && request.resource.data.replyTo.type is string
          )
        )
        && request.resource.data.createdAt == request.time;
    }

    function validEncryptedMessage() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'type', 'senderUid', 'recipientUid', 'cryptoVersion',
          'iv', 'ciphertext', 'aad', 'objectKey', 'expiresAt', 'mediaIv',
          'encryptedMediaMeta', 'senderFingerprint', 'recipientFingerprint',
          'senderPublicJwk', 'recipientPublicJwk', 'createdAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid != request.auth.uid
        && (request.resource.data.type == 'text'
            || request.resource.data.type == 'image'
            || request.resource.data.type == 'audio'
            || request.resource.data.type == 'file'
            || request.resource.data.type == 'video')
        && request.resource.data.cryptoVersion == 1
        && request.resource.data.senderFingerprint is string
        && request.resource.data.senderFingerprint.size() <= 128
        && request.resource.data.iv is string
        && request.resource.data.iv.size() <= 48
        && request.resource.data.aad is string
        && request.resource.data.aad.size() <= 256
        && (
          (
            request.resource.data.type == 'text'
            && request.resource.data.ciphertext is string
            && request.resource.data.ciphertext.size() > 0
            && request.resource.data.ciphertext.size() <= 65536
            && request.resource.data.iv.size() > 0
            && request.resource.data.objectKey == ''
            && request.resource.data.expiresAt == null
            && request.resource.data.mediaIv == ''
            && request.resource.data.encryptedMediaMeta == null
          ) || (
            (request.resource.data.type == 'image'
             || request.resource.data.type == 'audio'
             || request.resource.data.type == 'file'
             || request.resource.data.type == 'video')
            && request.resource.data.objectKey is string
            && request.resource.data.objectKey.size() > 0
            && request.resource.data.objectKey.size() <= 256
            && request.resource.data.objectKey.matches('^media/(image|audio|file|video)/.+')
            && request.resource.data.mediaIv is string
            && request.resource.data.mediaIv.size() > 0
            && request.resource.data.mediaIv.size() <= 48
            && request.resource.data.encryptedMediaMeta is map
            && request.resource.data.expiresAt is number
            && request.resource.data.expiresAt > request.time.toMillis()
          )
        )
        && (
          !request.resource.data.keys().hasAny([
            'recipientFingerprint', 'senderPublicJwk', 'recipientPublicJwk'
          ])
          || (
            request.resource.data.keys().hasAll([
              'recipientFingerprint', 'senderPublicJwk', 'recipientPublicJwk'
            ])
            && request.resource.data.recipientFingerprint is string
            && request.resource.data.recipientFingerprint.size() <= 128
            && request.resource.data.senderPublicJwk is map
            && request.resource.data.recipientPublicJwk is map
          )
        )
        && request.resource.data.createdAt == request.time;
    }

    function validMessage() {
      return validEncryptedMessage() || validMilestone2PlaintextMessage();
    }

    match /chatMembers/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'role', 'active', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.active == true;
      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'role', 'active', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    match /chatPublicKeys/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && validPublicKey(uid);
      allow update: if false; // Immutable during active lifecycle
      allow delete: if isSelf(uid); // Owner can clean up on account deletion
    }

    match /chatKeyBackups/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && validKeyBackup(uid);
      allow update: if isSelf(uid)
        && validKeyBackup(uid)
        && request.resource.data.fingerprint == resource.data.fingerprint;
      allow delete: if isSelf(uid);
    }

    function validLastMessage(lastMsg, participants) {
      return lastMsg == null || (
        lastMsg is map
        && lastMsg.keys().hasOnly(['type', 'senderUid', 'recipientUid', 'createdAt'])
        && lastMsg.senderUid in participants
        && lastMsg.recipientUid in participants
        && !('body' in lastMsg)
        && !('plaintext' in lastMsg)
        && !('preview' in lastMsg)
        && !('caption' in lastMsg)
        && !('filename' in lastMsg)
        && !('email' in lastMsg)
      );
    }

    function validParticipantDetails(details, participants) {
      return details == null || (
        details is map
        && (!('email' in details[participants[0]]))
        && (!('email' in details[participants[1]]))
      );
    }

    match /chatConversations/{conversationId} {
      allow get: if signedIn()
        && (resource == null || (resource.data.participants is list && request.auth.uid in resource.data.participants));
      allow list: if signedIn()
        && (resource.data.participants is list && request.auth.uid in resource.data.participants);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'id', 'participants', 'participantDetails', 'lastMessage', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.id == conversationId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && validParticipantDetails(request.resource.data.participantDetails, request.resource.data.participants)
        && validLastMessage(request.resource.data.lastMessage, request.resource.data.participants)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.keys().hasOnly([
          'id', 'participants', 'participantDetails', 'lastMessage', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && validParticipantDetails(request.resource.data.participantDetails, resource.data.participants)
        && validLastMessage(request.resource.data.lastMessage, resource.data.participants)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants
          && (resource.data.senderUid == request.auth.uid
              || resource.data.recipientUid == request.auth.uid);

        allow create: if signedIn()
          && messageId.matches('^![0-9]{13}_[0-9a-f]{24}$')
          && validMessage()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants
          && request.resource.data.recipientUid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants
          && request.resource.data.senderUid != request.resource.data.recipientUid
          && (
            !('replyTo' in request.resource.data)
            || request.resource.data.replyTo == null
            || request.resource.data.replyTo.senderUid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants
          );

        allow update: if false;

        allow delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants
          && resource.data.senderUid == request.auth.uid;
      }

      match /receipts/{receiptUid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants;

        allow create, update: if signedIn()
          && request.auth.uid == receiptUid
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants
          && request.resource.data.keys().hasOnly([
            'uid', 'conversationId', 'lastDeliveredMessageId', 'lastDeliveredAt',
            'lastReadMessageId', 'lastReadAt', 'updatedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.conversationId == conversationId
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }

      match /typing/{typingUid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants;

        allow create, update: if signedIn()
          && request.auth.uid == typingUid
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants
          && request.resource.data.keys().hasOnly([
            'uid', 'conversationId', 'typing', 'updatedAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.conversationId == conversationId
          && request.resource.data.typing is bool
          && request.resource.data.updatedAt == request.time;

        allow delete: if signedIn()
          && request.auth.uid == typingUid
          && request.auth.uid in get(/databases/$(database)/documents/chatConversations/$(conversationId)).data.participants;
      }
    }

    match /chatPresence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'online', 'lastSeen', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.online is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isSelf(uid);
    }

    match /chatPushTokens/{uid}/tokens/{tokenId} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid', 'token', 'tokenHash', 'platform', 'active', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20
        && request.resource.data.token.size() < 4096
        && request.resource.data.tokenHash == tokenId
        && request.resource.data.active == true;
      allow delete: if isSelf(uid);
    }

    match /calls/{callId} {
      // Milestone 7 Calling ditangguhkan: tolak semua akses ke calls collection
      allow read, write: if false;
    }

    match /callSessions/{callId} {
      function isParticipant(docData) {
        return request.auth.uid == docData.callerUid || request.auth.uid == docData.calleeUid;
      }

      allow read: if signedIn() && isParticipant(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'callerUid', 'calleeUid', 'conversationId',
          'type', 'state', 'callerName', 'offer', 'createdAt', 'expiresAt'
        ])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.type in ['voice', 'video']
        && request.resource.data.state == 'ringing'
        && request.resource.data.conversationId is string
        && exists(/databases/$(database)/documents/chatConversations/$(request.resource.data.conversationId))
        && get(/databases/$(database)/documents/chatConversations/$(request.resource.data.conversationId)).data.participants is list
        && get(/databases/$(database)/documents/chatConversations/$(request.resource.data.conversationId)).data.participants.size() == 2
        && request.resource.data.callerUid in get(/databases/$(database)/documents/chatConversations/$(request.resource.data.conversationId)).data.participants
        && request.resource.data.calleeUid in get(/databases/$(database)/documents/chatConversations/$(request.resource.data.conversationId)).data.participants
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.schemaVersion == 1
        && (!('callerName' in request.resource.data) || (
          request.resource.data.callerName is string
          && request.resource.data.callerName.size() <= 60
        ))
        && (!('offer' in request.resource.data) || (
          request.resource.data.offer is map
          && request.resource.data.offer.keys().hasOnly(['type', 'sdp'])
          && request.resource.data.offer.type == 'offer'
          && request.resource.data.offer.sdp is string
          && request.resource.data.offer.sdp.size() <= 65536
        ));

      allow update: if signedIn()
        && isParticipant(resource.data)
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'callerUid', 'calleeUid', 'conversationId',
          'type', 'state', 'callerName', 'offer', 'answer', 'reason',
          'createdAt', 'updatedAt', 'expiresAt', 'answeredAt', 'endedAt'
        ])
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.schemaVersion == resource.data.schemaVersion
        && (!('callerName' in resource.data) || request.resource.data.callerName == resource.data.callerName)
        && (!('offer' in resource.data) || request.resource.data.offer == resource.data.offer)
        && (
          (resource.data.state == 'ringing' && (
            (request.resource.data.state == 'accepted' && request.auth.uid == resource.data.calleeUid)
            || (request.resource.data.state == 'rejected' && request.auth.uid == resource.data.calleeUid)
            || (request.resource.data.state == 'missed')
            || (request.resource.data.state == 'ended' && request.auth.uid == resource.data.callerUid)
            || (request.resource.data.state == 'failed')
          ))
          || (resource.data.state == 'accepted' && (
            request.resource.data.state in ['connecting', 'connected', 'ended', 'failed']
          ))
          || (resource.data.state == 'connecting' && (
            request.resource.data.state in ['connected', 'ended', 'failed']
          ))
          || (resource.data.state == 'connected' && (
            request.resource.data.state in ['ended', 'failed']
          ))
        )
        && (!('answer' in request.resource.data)
            || (('answer' in resource.data) && request.resource.data.answer == resource.data.answer)
            || (
              request.auth.uid == resource.data.calleeUid
              && request.resource.data.answer is map
              && request.resource.data.answer.keys().hasOnly(['type', 'sdp'])
              && request.resource.data.answer.type == 'answer'
              && request.resource.data.answer.sdp is string
              && request.resource.data.answer.sdp.size() <= 65536
            ))
        && (!('reason' in request.resource.data) || (
          request.resource.data.reason is string
          && request.resource.data.reason.size() <= 100
        ));

      allow delete: if false;

      match /candidates/{candidateId} {
        allow read: if signedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.callerUid
              || request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.calleeUid);

        allow create: if signedIn()
          && (request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.callerUid
              || request.auth.uid == get(/databases/$(database)/documents/callSessions/$(callId)).data.calleeUid)
          && request.resource.data.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex', 'senderUid', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() <= 2048
          && request.resource.data.createdAt is timestamp;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}